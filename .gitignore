__pycache__/
*.pyc
*.log
*.sh
_archive/
MODELS/

# large read-only model-factory output & receptor data — not source code.
# models/curated/ is the one exception: small (~15MB) curated-compound
# source data that fresh/on-demand decoy generation needs bundled with
# the app (see BUILD_WINDOWS.md's --add-data entry for it) — a plain
# "models/" pattern can't be re-included per-subdirectory (git won't
# un-exclude a path whose parent directory is itself excluded), hence
# models/* instead of models/ here.
models/*
!models/curated
docking_targets/
.venv/
*.egg-info/
dist/
build/
*.spec

# S3 upload staging for the Downloads tab (backend/scripts/build_download_manifest.py)
# — regenerated from models/+docking_targets/, not source code
_download_staging/

# frontend (React/Vite source in frontend/ — dist/ is its standalone build
# output, no longer committed now that the backend doesn't serve it)
frontend/node_modules/
frontend/dist/
frontend/*.tsbuildinfo
frontend/.env.local
frontend/.env.*.local
_decoy_pool_cache.pkl
