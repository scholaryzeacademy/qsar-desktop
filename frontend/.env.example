# Copy to .env.local and set when the frontend is served from a different
# origin than the backend (e.g. a built/deployed frontend, or `vite preview`).
# Leave unset for `npm run dev` — the Vite proxy in vite.config.ts already
# forwards /api to the backend on :8000.
#
# VITE_API_BASE=http://127.0.0.1:8000
